# ==============================================================================
# Variables d'Environnement de Développement - Exemple (.env.development.example)
# ==============================================================================
# 
# Ce fichier sert de modèle pour le fichier '.env.development' utilisé lors
# de l'exécution locale de l'application (`npm run dev`).
# 
# Pour l'utiliser, dupliquez-le sous le nom '.env.development' :
#   cp .env.development.example .env.development
# 
# ==============================================================================

# URLs locales de votre machine
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Clé secrète de session NextAuth en développement
# (En local, une chaîne quelconque suffit, ex: 32 caractères aléatoires)
NEXTAUTH_SECRET=cle_secrete_aleatoire_pour_le_dev_32_caracteres_min

# ==============================================================================
# 1. Base de données MySQL Locale (mysql2 natif & Prisma)
# ==============================================================================
# Hôte local (généralement localhost ou 127.0.0.1)
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=nextmysql
MYSQL_PORT=3306

# Chaîne de connexion MySQL pour Prisma ORM
DATABASE_URL_MYSQL="mysql://root:@localhost:3306/nextmysql"

# ==============================================================================
# 2. Base de données PostgreSQL Locale (pg natif & Prisma)
# ==============================================================================
# Hôte local (généralement localhost ou 127.0.0.1)
PG_HOST=localhost
PG_USER=postgres
PG_PASSWORD=votre_mot_de_passe_postgres_local
PG_DATABASE=nextpg
PG_PORT=5432

# Chaîne de connexion PostgreSQL pour Prisma ORM
DATABASE_URL_PG="postgresql://postgres:votre_mot_de_passe_postgres_local@localhost:5432/nextpg"
