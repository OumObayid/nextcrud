# ==============================================================================
# Variables d'Environnement de Production - Exemple (.env.production.example)
# ==============================================================================
# 
# Ce fichier sert de modèle pour le fichier '.env.production' utilisé lors
# de la mise en ligne et de la génération du bundle (`npm run build`, `npm start`).
# 
# Pour l'utiliser, dupliquez-le sous le nom '.env.production' sur votre serveur :
#   cp .env.production.example .env.production
# 
# ==============================================================================

# Nom de domaine public de votre site en production (HTTPS obligatoire)
NEXT_PUBLIC_BASE_URL=https://votre-domaine.com
NEXTAUTH_URL=https://votre-domaine.com

# Clé secrète NextAuth de production hautement sécurisée
# Conseil : Générez-en une avec la commande `openssl rand -base64 32`
NEXTAUTH_SECRET=remplacez_par_une_cle_secrete_ultra_securisee_32_caracteres_min

# ==============================================================================
# 1. Base de données MySQL Distante (mysql2 natif & Prisma)
# ==============================================================================
# Coordonnées du serveur MySQL hébergé (ex: Railway, Clever Cloud, Aiven, OVH)
MYSQL_HOST=hote-mysql-distant.exemple.com
MYSQL_USER=utilisateur_mysql_distant
MYSQL_PASSWORD=mot_de_passe_mysql_robuste
MYSQL_DATABASE=nextmysql
MYSQL_PORT=3306

# Chaîne de connexion MySQL pour Prisma ORM (avec encodage URL des caractères spéciaux)
DATABASE_URL_MYSQL="mysql://utilisateur_mysql_distant:mot_de_passe_mysql_robuste@hote-mysql-distant.exemple.com:3306/nextmysql"

# ==============================================================================
# 2. Base de données PostgreSQL Distante (pg natif & Prisma)
# ==============================================================================
# Coordonnées du serveur PostgreSQL hébergé (ex: Supabase, Neon, Render, Railway)
PG_HOST=hote-postgres-distant.exemple.com
PG_USER=utilisateur_postgres_distant
PG_PASSWORD=mot_de_passe_postgres_robuste
PG_DATABASE=nextpg
PG_PORT=5432

# Chaîne de connexion PostgreSQL pour Prisma ORM
DATABASE_URL_PG="postgresql://utilisateur_postgres_distant:mot_de_passe_postgres_robuste@hote-postgres-distant.exemple.com:5432/nextpg?sslmode=require"
