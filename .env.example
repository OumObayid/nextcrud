# ==============================================================================
# Variables d'Environnement Communes - Exemple (.env.example)
# ==============================================================================
# 
# Ce fichier sert de modèle pour le fichier '.env' commun à tous les environnements.
# 
# Pour l'utiliser, dupliquez-le sous le nom '.env' :
#   cp .env.example .env
# 
# ==============================================================================

# Port d'écoute par défaut du serveur web
PORT=3000
NEXT_PUBLIC_PORT=3000

# Fournisseur OAuth Google (Console Google Cloud : https://console.cloud.google.com/)
# Nécessaire pour le bouton "Se connecter avec Google"
GOOGLE_CLIENT_ID=votre_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=votre_google_client_secret

# Coordonnées publiques Support & Contact (affichées dans le Navbar, Footer et Modales)
CONTACT_SUPPORT="contact@exemple.com"
TELEPHONE="0600000000"
NEXT_PUBLIC_CONTACT_SUPPORT="contact@exemple.com"
NEXT_PUBLIC_TELEPHONE="0600000000"
